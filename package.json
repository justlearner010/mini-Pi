{
  "name": "mini-pi",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": { "mini-pi": "./dist/src/cli.js" },
  "engines": { "node": ">=22" },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc --noEmit -p tsconfig.json",
    "test": "tsx --test test/**/*.test.ts",
    "verify:bin": "node scripts/verify-bin.mjs",
    "verify:package": "rm -rf dist && npm run build && npm pack --dry-run",
    "dev": "tsx src/cli.ts"
  },
  "dependencies": {
    "@inquirer/select": "5.2.1",
    "openai": "7.4.0",
    "typescript": "5.9.3"
  },
  "devDependencies": {
    "@types/node": "26.2.0",
    "tsx": "4.23.12"
  }
}
