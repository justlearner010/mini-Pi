{
  "name": "mini-pi",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "mini-pi": "./dist/src/cli.js"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "benchmark:large": "npm run build && node scripts/benchmark-large-project.mjs",
    "benchmark:large:json": "node scripts/benchmark-large-project.mjs",
    "benchmark:repo-map": "npm run build && node scripts/benchmark-query-repo-map.mjs",
    "benchmark:repo-map:json": "node scripts/benchmark-query-repo-map.mjs",
    "benchmark:deepseek-harness": "npm run build && node scripts/benchmark-deepseek-harness-repo-map.mjs",
    "benchmark:deepseek-harness:json": "node scripts/benchmark-deepseek-harness-repo-map.mjs",
    "benchmark:deepseek-harness:live": "npm run build && node scripts/benchmark-deepseek-harness-live.mjs",
    "verify:benchmark": "npm run build && node scripts/verify-benchmark.mjs",
    "verify:repo-map": "npm run build && node scripts/verify-query-repo-map.mjs",
    "verify:deepseek-harness": "npm run build && node scripts/verify-deepseek-harness-repo-map.mjs",
    "verify:deepseek-harness:live": "npm run build && node scripts/verify-deepseek-harness-live.mjs",
    "check": "tsc --noEmit -p tsconfig.json",
    "test": "tsx --test test/**/*.test.ts",
    "verify:bin": "node scripts/verify-bin.mjs",
    "verify:package": "rm -rf dist && npm run build && npm pack --dry-run",
    "dev": "tsx src/cli.ts"
  },
  "dependencies": {
    "@github/keytar": "7.10.6",
    "@inquirer/password": "5.1.1",
    "@inquirer/select": "5.2.1",
    "ignore": "7.0.6",
    "markdansi": "0.3.2",
    "openai": "7.4.0",
    "typescript": "5.9.3"
  },
  "devDependencies": {
    "@types/node": "26.2.0",
    "tsx": "4.23.12"
  }
}
